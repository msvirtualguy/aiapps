# TEMPLATE — safe to commit. Contains placeholder values only.
# Copy to config/.env and fill in real values.
# config/.env is gitignored and will NOT be committed.

# NVIDIA GPU Cloud API key — obtain from https://ngc.nvidia.com
# Required for all NIM containers (Qwen3, nv-embedqa, Parakeet, NV-Ingest, NeMo Curator)
NGC_API_KEY=your-ngc-api-key-here

# HuggingFace token — required if nvidia/personaplex-7b-v1 is a gated model
# Obtain from https://huggingface.co/settings/tokens
# Leave blank if the model is publicly accessible without auth
HF_TOKEN=

# DGX Spark node IP and SSH user (add IP to /etc/hosts on your workstation)
#   <DGX_SPARK_IP>  spark.local
#   <DGX_SPARK_IP>  csagent.local
DGX_SPARK_IP=192.168.x.x
SPARK_USER=msheehy

# NFS server and share path (source data — customer PII, return policy, RMA exceptions)
NFS_SERVER=192.168.110.200
NFS_SHARE=/volume1/k3s/data
